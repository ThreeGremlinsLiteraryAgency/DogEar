{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paper-gremlin-catalog",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "r2_buckets": [{"binding": "CATALOG_ARCHIVE", "bucket_name": "paper-gremlin-catalog-archive"}],
  "d1_databases": [{"binding": "CATALOG_DB", "database_name": "paper-gremlin-catalog", "database_id": "f238d108-19a6-498c-9703-a594be211826"}],
  "vars": {"ALLOWED_ORIGIN": "https://threegremlinsliteraryagency.github.io"}
}
